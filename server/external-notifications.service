[Unit]
Description=LimeNote external SNS event listener
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=limenote
WorkingDirectory=/opt/limenote
EnvironmentFile=/etc/limenote/notification-worker.env
ExecStart=/usr/bin/node /opt/limenote/server/external-notifications.mjs
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true

[Install]
WantedBy=multi-user.target
